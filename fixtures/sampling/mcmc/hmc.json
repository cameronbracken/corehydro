    {
      "name": "normal_short_exact",
      "note": "ess tolerance loosened to match the DEMCzs normal_short_exact precedent (see fixtures/README.md) after CI run 28657005803: Windows MSVC tripped ess[0] by 1 of 3741 checks. ESS's Geyer-style autocorrelation-lag truncation is a discontinuous function of its input series, so the same sub-ULP libm noise that HMC's finite-difference gradient already amplifies (see normal_rstan's note) can nudge a truncation-lag decision by one step and shift ESS measurably more than the underlying chain values moved -- same mechanism as DEMCzs's normal_short_exact ess (tol 0.25). rhat, which reads only MarkovChains (no output-phase autocorrelation truncation), stayed exact on every platform in that run and is left untouched.",
      "construct": {
        "model": {
          "name": "uniform_constraints",
          "family": "Normal",
          "dataset": "tippecanoe"
        },
        "settings": {
          "initialize": "Randomize",
          "step_size": 2.5,
          "steps": 5,
          "iterations": 100,
          "warmup_iterations": 10,
          "thinning_interval": 1
        }
