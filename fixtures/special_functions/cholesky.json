    },
    {
      "name": "inverse_2x2_11",
      "target": "Cholesky.inverse_element",
      "args": [4, 2, 2, 3, 1, 1],
      "assertions": [ { "method": "value", "expected": 0.49999999999999994, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "solve_2x2_0",
      "target": "Cholesky.solve_element",
      "args": [4, 2, 2, 3, 1, 2, 0],
      "assertions": [ { "method": "value", "expected": -0.12499999999999994, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "solve_2x2_1",
      "target": "Cholesky.solve_element",
      "args": [4, 2, 2, 3, 1, 2, 1],
      "assertions": [ { "method": "value", "expected": 0.74999999999999989, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "is_pd_2x2_true",
      "target": "Cholesky.is_positive_definite",
      "args": [4, 2, 2, 3],
      "assertions": [ { "method": "value", "expected": 1.0, "mode": "equal" } ]
    },
    {
      "name": "is_pd_2x2_false_non_pd",
      "target": "Cholesky.is_positive_definite",
      "args": [1, 2, 2, 1],
      "assertions": [ { "method": "value", "expected": 0.0, "mode": "equal" } ]
    },
    {
      "name": "is_pd_2x2_false_nan",
      "target": "Cholesky.is_positive_definite",
      "args": [1, 0, 0, "nan"],
      "assertions": [ { "method": "value", "expected": 0.0, "mode": "equal" } ]
    },
    {
      "name": "is_pd_3x3_false_numerically_rank_deficient",
      "target": "Cholesky.is_positive_definite",
      "args": [2, 0.5, 2, 0.5, 1, 0.5, 2, 0.5, 2],
      "assertions": [ { "method": "value", "expected": 0.0, "mode": "equal" } ]
    }
  ]
}
