{
  "kind": "special_function",
  "target": "Cholesky",
  "source": "Numerics/Mathematics/Linear Algebra/CholeskyDecomposition.cs; oracles cross-checked against Test_CholeskyDecomposition.cs (Test_CholeskyDecomp, Test_CholeskyDecompVals, Test_LogDeterminant, Test_Inverse, Test_Solve, Test_Forward, Test_Back)",
  "reference": "Numerics @ 7e8e8d1. Each case's `target` selects the dispatch function. Matrices are flattened row-major; the rank-deficient covariance case pins the v2.2.0 diagonal-relative pivot tolerance.",
  "cases": [
    {
      "name": "det_3x3",
      "target": "Cholesky.determinant",
      "args": [16, 4, 8, 4, 5, -4, 8, -4, 22],
      "assertions": [ { "method": "value", "expected": 576.0, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "log_det_3x3",
      "target": "Cholesky.log_determinant",
      "args": [16, 4, 8, 4, 5, -4, 8, -4, 22],
      "assertions": [ { "method": "value", "expected": 6.3561076606958906, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "inverse_3x3_00",
      "target": "Cholesky.inverse_element",
      "args": [16, 4, 8, 4, 5, -4, 8, -4, 22, 0, 0],
      "assertions": [ { "method": "value", "expected": 0.16319444444444445, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "inverse_3x3_01",
      "target": "Cholesky.inverse_element",
      "args": [16, 4, 8, 4, 5, -4, 8, -4, 22, 0, 1],
      "assertions": [ { "method": "value", "expected": -0.20833333333333334, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "inverse_3x3_02",
      "target": "Cholesky.inverse_element",
      "args": [16, 4, 8, 4, 5, -4, 8, -4, 22, 0, 2],
      "assertions": [ { "method": "value", "expected": -0.09722222222222222, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "inverse_3x3_11",
      "target": "Cholesky.inverse_element",
      "args": [16, 4, 8, 4, 5, -4, 8, -4, 22, 1, 1],
      "assertions": [ { "method": "value", "expected": 0.5, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "inverse_3x3_12",
      "target": "Cholesky.inverse_element",
      "args": [16, 4, 8, 4, 5, -4, 8, -4, 22, 1, 2],
      "assertions": [ { "method": "value", "expected": 0.16666666666666666, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "inverse_3x3_22",
      "target": "Cholesky.inverse_element",
      "args": [16, 4, 8, 4, 5, -4, 8, -4, 22, 2, 2],
      "assertions": [ { "method": "value", "expected": 0.1111111111111111, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "solve_3x3_0",
      "target": "Cholesky.solve_element",
      "args": [16, 4, 8, 4, 5, -4, 8, -4, 22, 16, 18, -22, 0],
      "assertions": [ { "method": "value", "expected": 1.0, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "solve_3x3_1",
      "target": "Cholesky.solve_element",
      "args": [16, 4, 8, 4, 5, -4, 8, -4, 22, 16, 18, -22, 1],
      "assertions": [ { "method": "value", "expected": 2.0, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "solve_3x3_2",
      "target": "Cholesky.solve_element",
      "args": [16, 4, 8, 4, 5, -4, 8, -4, 22, 16, 18, -22, 2],
      "assertions": [ { "method": "value", "expected": -1.0, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "det_2x2",
      "target": "Cholesky.determinant",
      "args": [4, 2, 2, 3],
      "assertions": [ { "method": "value", "expected": 8.0000000000000018, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "log_det_2x2",
      "target": "Cholesky.log_determinant",
      "args": [4, 2, 2, 3],
      "assertions": [ { "method": "value", "expected": 2.0794415416798362, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "inverse_2x2_00",
      "target": "Cholesky.inverse_element",
      "args": [4, 2, 2, 3, 0, 0],
      "assertions": [ { "method": "value", "expected": 0.375, "mode": "abs", "tol": 1e-10 } ]
    },
    {
      "name": "inverse_2x2_01",
      "target": "Cholesky.inverse_element",
      "args": [4, 2, 2, 3, 0, 1],
