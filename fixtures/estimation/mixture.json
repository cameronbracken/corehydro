{
  "target": "MaximumLikelihood",
  "kind": "model_estimation",
  "source": "Exact oracle values dumped from the real RMC.BestFit MaximumLikelihood against Numerics v2.2.0 via tools/oracle_emitter --dump and reproduced by tools/verify_oracles.py. Exercises the mixture model type: EM-seeded defaults plus NelderMead; the second case sets zero_inflated: true on data with zeros. Parameter layout: [w_1, w_2, mu_1, sigma_1, mu_2, sigma_2]. Numerics v2.2 normalizes a private parameter copy in SetParameters(ref), so the optimizer's raw weight coordinates are preserved rather than overwritten. NelderMead point values use relative tolerance 1e-9. Covariance and standard errors are not asserted because the near-singular Hessian makes individual entries noise sensitive. The Jeffreys and clone regressions remain in core/tests/test_mixture_model.cpp because the declarative model builder cannot construct those stateful cases.",
  "datasets": {
    "bimodal_series": [
      520,
      580,
      610,
      650,
      700,
      730,
      760,
      800,
      850,
      880,
      910,
      950,
      990,
      1030,
      1080,
      5000,
      5400,
      5800,
      6300,
      6800
    ],
    "zero_series": [
      0,
      0,
      120,
      340,
      0,
      560,
      780,
      150,
      430,
      920,
      210,
      380,
      0,
      640,
      275
    ]
  },
  "cases": [
    {
      "name": "two_normal_mixture",
      "construct": {
        "model": {
          "type": "mixture",
          "families": [
            "Normal",
            "Normal"
          ],
          "dataset": "bimodal_series"
        },
        "optimizer": "NelderMead"
      },
      "assertions": [
        {
          "method": "parameter",
          "args": [
            0
          ],
          "expected": 1.0,
          "mode": "rel",
          "tol": 1e-09
        },
        {
          "method": "parameter",
          "args": [
            1
          ],
          "expected": 0.3334646179975355,
          "mode": "rel",
          "tol": 1e-09
        },
        {
          "method": "parameter",
          "args": [
            2
          ],
          "expected": 802.6801382287679,
          "mode": "rel",
          "tol": 1e-09
        },
        {
          "method": "parameter",
          "args": [
            3
          ],
          "expected": 165.85869159189076,
          "mode": "rel",
          "tol": 1e-09
        },
        {
          "method": "parameter",
          "args": [
            4
          ],
          "expected": 5860.0429650882115,
          "mode": "rel",
          "tol": 1e-09
        },
        {
          "method": "max_log_likelihood",
          "args": [],
          "expected": -148.58128103193022,
          "mode": "rel",
          "tol": 1e-09
        }
      ]
    },
    {
      "name": "two_normal_mixture_zero_inflated",
      "construct": {
        "model": {
          "type": "mixture",
          "families": [
            "Normal",
            "Normal"
          ],
          "dataset": "zero_series",
          "zero_inflated": true
        },
        "optimizer": "NelderMead"
      },
      "assertions": [
        {
          "method": "parameter",
          "args": [
            0
          ],
          "expected": 0.45585630068256106,
          "mode": "rel",
          "tol": 1e-09
        },
        {
          "method": "max_log_likelihood",
          "args": [],
          "expected": -83.58898296481541,
          "mode": "rel",
          "tol": 1e-09
        }
      ]
    }
  ]
}
