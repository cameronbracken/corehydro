    {
      "name": "log_likelihoods_on_raw_data",
      "note": "The three log-likelihood surfaces BivariateCopulaEstimation optimizes, evaluated at a FIXED theta over the RAW paired sample (args name the two datasets; see fixtures/README.md). The pseudo arm is the one that matters here: PseudoLogLikelihood is defined on values already in (0, 1) and does not rank internally, so the caller converts the sample to its Weibull plotting positions first -- rank / (n + 1) over Statistics.RanksInPlace, exactly as Test_MPL_Fit does. The IFM and full arms push the raw sample through the attached Normal marginals themselves.",
      "construct": {"theta": 0.5, "df": 5, "marginals": {"targets": ["Normal", "Normal"], "params": [[100.0, 15.0], [80.0, 25.0]]}},
      "assertions": [
        {"method": "log_likelihood_pseudo", "args": ["data1", "data2"], "expected": 35.55554124407267, "mode": "rel", "tol": 1e-10, "source": "curated via oracle_emitter --dump"},
        {"method": "log_likelihood_ifm",    "args": ["data1", "data2"], "expected": 36.506963458357774, "mode": "rel", "tol": 1e-10, "source": "curated via oracle_emitter --dump"},
        {"method": "log_likelihood_full",   "args": ["data1", "data2"], "expected": -836.3514127368377, "mode": "rel", "tol": 1e-10, "source": "curated via oracle_emitter --dump"}
      ]
    }
  ]
