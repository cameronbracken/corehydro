{
  "target": "KappaFour",
  "kind": "univariate_distribution",
  "source": "Numerics/Test_Numerics/Distributions/Univariate/Test_KappaFourRegression.cs",
  "cases": [
    {
      "name": "probability_oracle_negative_shapes_lower_tail",
      "construct": { "params": [0.0, 1.0, -2.0, -2.0] },
      "assertions": [
        { "method": "quantile", "args": [0.01], "expected": -0.4999999799959994, "mode": "rel", "tol": 2e-12 },
        { "method": "cdf", "args": [-0.4999999799959994], "expected": 0.010000000002818024, "mode": "abs", "tol": 2e-10 },
        { "method": "pdf", "args": [-0.4999999799959994], "expected": 124962.50364420966, "mode": "rel", "tol": 2e-8 },
        { "method": "quantile_gradient", "args": [0.01, 2], "expected": -0.2499998196220625, "mode": "rel", "tol": 2e-8 },
        { "method": "quantile_gradient", "args": [0.01, 3], "expected": 1.642580799359263e-7, "mode": "rel", "tol": 2e-8 }
      ]
    },
    {
      "name": "probability_oracle_near_zero_shapes",
      "construct": { "params": [0.0, 1.0, 1e-8, 1e-8] },
      "assertions": [
        { "method": "quantile", "args": [0.5], "expected": 0.3665129233757416, "mode": "rel", "tol": 2e-12 },
        { "method": "cdf", "args": [0.3665129233757416], "expected": 0.5, "mode": "abs", "tol": 2e-10 },
        { "method": "pdf", "args": [0.3665129233757416], "expected": 0.3465735927513422, "mode": "rel", "tol": 2e-8 },
        { "method": "quantile_gradient", "args": [0.5, 2], "expected": -0.06716586158277331, "mode": "rel", "tol": 2e-8 },
        { "method": "quantile_gradient", "args": [0.5, 3], "expected": 0.34657358860935816, "mode": "rel", "tol": 2e-8 }
      ]
    },
    {
      "name": "probability_oracle_finite_upper_support",
      "construct": { "params": [0.0, 1.0, 2.0, 0.5] },
      "assertions": [
        { "method": "quantile", "args": [0.5], "expected": 0.3284271247461901, "mode": "rel", "tol": 2e-12 },
        { "method": "cdf", "args": [0.3284271247461901], "expected": 0.5, "mode": "abs", "tol": 2e-10 },
        { "method": "pdf", "args": [0.3284271247461901], "expected": 1.2071067811865477, "mode": "rel", "tol": 2e-8 },
        { "method": "quantile_gradient", "args": [0.5, 2], "expected": -0.0724563892467588, "mode": "rel", "tol": 2e-8 },
        { "method": "quantile_gradient", "args": [0.5, 3], "expected": 0.11206957519803584, "mode": "rel", "tol": 2e-8 }
      ]
    },
    {
      "name": "expected_information_gumbel_limit",
      "construct": { "params": [0.0, 1.0, 0.0, 0.0] },
      "assertions": [
        { "method": "parameter_covariance", "args": [1, 0, 0], "expected": 3.4816596168698939, "mode": "rel", "tol": 2e-9 },
        { "method": "parameter_covariance", "args": [1, 0, 1], "expected": -2.5451965889656565, "mode": "rel", "tol": 2e-9 },
        { "method": "parameter_covariance", "args": [1, 1, 1], "expected": 4.3723119313264966, "mode": "rel", "tol": 2e-9 },
        { "method": "parameter_covariance", "args": [1, 2, 2], "expected": 1.358803511471405, "mode": "rel", "tol": 2e-9 },
        { "method": "parameter_covariance", "args": [1, 3, 3], "expected": 7.2709164964372297, "mode": "rel", "tol": 2e-9 }
      ]
    }
