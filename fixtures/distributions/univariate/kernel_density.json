{
  "target": "KernelDensity",
  "kind":   "univariate_distribution",
  "source": "Numerics/Test_Numerics/Distributions/Univariate/Test_KernelDensity.cs",
  "datasets": {
    "tippecanoe": [6290, 2700, 13100, 16900, 14600, 9600, 7740, 8490, 8130, 12000, 17200, 15000, 12400, 6960, 6500, 5840, 10400, 18800, 21400, 22600, 14200, 11000, 12800, 15700, 4740, 6950, 11800, 12100, 20600, 14600, 14600, 8900, 10600, 14200, 14100, 14100, 12500, 7530, 13400, 17600, 13400, 19200, 16900, 15500, 14500, 21900, 10400, 7460]
  },
  "cases": [
    {
      "name": "gaussian_default_pdf",
      "construct": {"data": "tippecanoe", "kernel": "Gaussian"},
      "assertions": [
        { "method": "pdf",              "args": [2328.878], "expected": 1.0423134048637404e-05, "mode": "abs", "tol": 1e-9 },
        { "method": "pdf",              "args": [12221.33], "expected": 7.4122039062202643e-05,  "mode": "abs", "tol": 1e-9 },
        { "method": "pdf",              "args": [28708.74], "expected": 1.8292309077128219e-07,  "mode": "abs", "tol": 1e-11 },
        { "method": "minimum",          "args": [],         "expected": 2700.0,                  "mode": "equal" },
        { "method": "maximum",          "args": [],         "expected": 22600.0,                 "mode": "equal" },
        { "method": "parameters_valid", "args": [],         "expected": true,                    "mode": "bool" }
      ]
    },
    {
      "name": "gaussian_unbounded_cdf",
      "construct": {"data": "tippecanoe", "kernel": "Gaussian", "bounded_by_data": false},
      "assertions": [
        { "method": "cdf",      "args": [2328.878],  "expected": 0.01734183, "mode": "abs", "tol": 1e-2 },
        { "method": "cdf",      "args": [12221.33],  "expected": 0.4669572,  "mode": "abs", "tol": 1e-2 },
        { "method": "cdf",      "args": [28708.74],  "expected": 0.9999118,  "mode": "abs", "tol": 1e-2 },
        { "method": "quantile", "args": [0.4669572], "expected": 12221.33,   "mode": "abs", "tol": 100.0 }
      ]
    },
    {
      "name": "invalid_nan_bandwidth",
      "note": "v2.1.4: the private Bandwidth ValidateParameters(double, bool) now rejects NaN/Infinity explicitly (previously only `value <= 0d`, false for +Infinity -- see kernel_density.hpp file header note).",
      "construct": {"data": "tippecanoe", "kernel": "Gaussian", "bandwidth": "nan"},
      "assertions": [
        { "method": "parameters_valid", "args": [], "expected": false, "mode": "bool" }
      ]
    },
    {
      "name": "invalid_inf_bandwidth",
      "note": "v2.1.4 real fix: `Infinity <= 0d` is false, so an infinite bandwidth silently read as valid before this explicit isnan/isinf check was added.",
      "construct": {"data": "tippecanoe", "kernel": "Gaussian", "bandwidth": "inf"},
      "assertions": [
        { "method": "parameters_valid", "args": [], "expected": false, "mode": "bool" }
      ]
    },
    {
      "name": "gaussian_moments_density_and_seeded_draws",
      "note": "The nine verbs the R/Python distribution surface exposes that no other KernelDensity case reaches: LogPDF, Mean/Median/StandardDeviation/Skewness/Kurtosis, the summed LogLikelihood over a sample drawn from the tippecanoe record itself, and the seeded MersenneTwister draw stream (KernelDensity does not override GenerateRandomValues, so each draw is InverseCDF of one uniform). Same data and kernel as gaussian_default_pdf above, plus Mode. Mode was unassertable until mode() was switched from a 1000-point grid scan to the BrentSearch maximization C# does (13478.10 vs 13470.18); it now agrees to 2.0e-11 relative, against the 1e-9 pin here. The median and the three draws are pinned at 1e-12 relative / 1e-9 absolute against measured agreements of 2.0e-15 and 4.0e-11.",
      "construct": {"data": "tippecanoe", "kernel": "Gaussian"},
      "assertions": [
        { "method": "log_pdf",        "args": [12221.33], "expected": -9.509797646642156, "mode": "rel", "tol": 1e-8, "source": "curated via oracle_emitter --dump" },
        { "method": "mean",           "args": [], "expected": 12665.208333333334, "mode": "rel", "tol": 1e-8, "source": "curated via oracle_emitter --dump" },
        { "method": "median",         "args": [], "expected": 12613.148806333598, "mode": "rel", "tol": 1e-12, "source": "curated via oracle_emitter --dump" },
        { "method": "sd",             "args": [], "expected": 4709.741823155504, "mode": "rel", "tol": 1e-8, "source": "curated via oracle_emitter --dump" },
        { "method": "skewness",       "args": [], "expected": 0.11936114284892954, "mode": "rel", "tol": 1e-8, "source": "curated via oracle_emitter --dump" },
        { "method": "kurtosis",       "args": [], "expected": -0.43694485806225725, "mode": "rel", "tol": 1e-8, "source": "curated via oracle_emitter --dump" },
        { "method": "log_likelihood", "args": [6290, 9600, 12400, 15000, 18800], "expected": -49.112770902031095, "mode": "rel", "tol": 1e-8, "source": "curated via oracle_emitter --dump" },
        { "method": "random_value",   "args": [5, 42, 0], "expected": 10954.79657154445, "mode": "abs", "tol": 1e-9, "source": "curated via oracle_emitter --dump" },
        { "method": "random_value",   "args": [5, 42, 1], "expected": 16550.89788687441, "mode": "abs", "tol": 1e-9, "source": "curated via oracle_emitter --dump" },
        { "method": "random_value",   "args": [5, 42, 4], "expected": 15552.502325375184, "mode": "abs", "tol": 1e-9, "source": "curated via oracle_emitter --dump" },
        { "method": "mode",           "args": [], "expected": 13470.180323329207, "mode": "rel", "tol": 1e-9, "source": "curated via oracle_emitter --dump" }
      ]
    }
  ]
}
