        { "method": "cdf",      "args": [-0.5],  "expected": 0.1,  "mode": "abs", "tol": 1e-12 },
        { "method": "cdf",      "args": [0.5],   "expected": 0.9,  "mode": "abs", "tol": 1e-12 },
        { "method": "cdf",      "args": [0.0],   "expected": 0.5,  "mode": "abs", "tol": 1e-12 },
