{
  "target": "Mixture",
  "kind":   "univariate_distribution",
  "source": "Numerics/Test_Numerics/Distributions/Univariate/Test_Mixture.cs",
  "reference": "R 'mistr' package; analytical solutions for mean/sd of Normal mixture",
  "cases": [
    {
      "name": "three_normal_pdf_cdf",
      "construct": {
        "components": [
          {"target": "Normal", "params": [10, 2]},
          {"target": "Normal", "params": [20, 1]},
          {"target": "Normal", "params": [30, 5]}
        ],
        "weights": [0.3, 0.2, 0.5]
      },
      "assertions": [
        { "method": "pdf",     "args": [30],  "expected": 0.03989423,  "mode": "abs", "tol": 1e-5 },
        { "method": "pdf",     "args": [20],  "expected": 0.08518778,  "mode": "abs", "tol": 1e-5 },
        { "method": "pdf",     "args": [10],  "expected": 0.05985473,  "mode": "abs", "tol": 1e-5 },
        { "method": "cdf",     "args": [30],  "expected": 0.75,        "mode": "abs", "tol": 1e-5 },
        { "method": "cdf",     "args": [20],  "expected": 0.411375,    "mode": "abs", "tol": 1e-4 },
        { "method": "cdf",     "args": [10],  "expected": 0.1500158,   "mode": "abs", "tol": 1e-5 },
        { "method": "quantile","args": [0.75],"expected": 30,          "mode": "abs", "tol": 1e-4 },
        { "method": "mean",    "args": [],     "expected": 22,          "mode": "abs", "tol": 1e-4 },
        { "method": "sd",      "args": [],     "expected": 9.481561,    "mode": "abs", "tol": 1e-3 },
        { "method": "minimum", "args": [],     "expected": "-inf",      "mode": "equal" },
        { "method": "maximum", "args": [],     "expected": "inf",       "mode": "equal" },
        { "method": "parameters_valid", "args": [], "expected": true,  "mode": "bool" }
      ]
    },
    {
      "name": "two_normal_basic",
      "construct": {
        "components": [
          {"target": "Normal", "params": [0, 1]},
          {"target": "Normal", "params": [5, 2]}
        ],
        "weights": [0.5, 0.5]
      },
      "assertions": [
        { "method": "pdf",     "args": [2.5],  "expected": 0.054426,    "mode": "abs", "tol": 1e-4 },
        { "method": "cdf",     "args": [2.5],  "expected": 0.549716,    "mode": "abs", "tol": 1e-4 },
        { "method": "mean",    "args": [],      "expected": 2.5,         "mode": "abs", "tol": 1e-4 },
        { "method": "sd",      "args": [],      "expected": 2.958040,    "mode": "abs", "tol": 1e-3 },
        { "method": "parameters_valid", "args": [], "expected": true,   "mode": "bool" }
      ]
    },
    {
      "name": "zero_inflation_rescales_weights",
      "construct": {
        "components": [
          {"target": "Normal", "params": [0, 1]},
          {"target": "Normal", "params": [5, 2]}
        ],
        "weights": [0.25, 0.75],
        "zero_inflated": true,
        "zero_weight": 0.2
      },
      "assertions": [
        { "method": "param",   "args": [0],    "expected": 0.2,                "mode": "abs", "tol": 1e-12 },
        { "method": "param",   "args": [1],    "expected": 0.6,                "mode": "abs", "tol": 1e-12 },
        { "method": "pdf",     "args": [-1.0], "expected": 0.2,                "mode": "abs", "tol": 1e-12 },
        { "method": "pdf",     "args": [0.0],  "expected": 0.2,                "mode": "abs", "tol": 1e-12 },
        { "method": "pdf",     "args": [5.0],  "expected": 0.11968298146433276, "mode": "abs", "tol": 1e-9 },
        { "method": "cdf",     "args": [0.0],  "expected": 0.2,                "mode": "abs", "tol": 1e-12 },
        { "method": "cdf",     "args": [5.0],  "expected": 0.69999994266968568, "mode": "abs", "tol": 1e-9 },
        { "method": "parameters_valid", "args": [], "expected": true,          "mode": "bool" }
      ]
    },
    {
      "name": "zero_inflation_disabled_leaves_weights_invalid",
      "construct": {
        "components": [
          {"target": "Normal", "params": [0, 1]},
          {"target": "Normal", "params": [5, 2]}
        ],
        "weights": [0.2, 0.6],
        "zero_inflated": false
      },
      "assertions": [
        { "method": "parameters_valid", "args": [], "expected": false, "mode": "bool" }
      ]
    },
    {
      "name": "moments_log_pdf_log_likelihood_and_seeded_draws",
      "note": "The verbs the R/Python distribution surface exposes that no other Mixture case reaches: Median, Mode, LogPDF, the summed LogLikelihood over a sample, and the seeded draw stream from Mixture's own GenerateRandomValues override (component selection, not the base InverseCDF-of-a-uniform path). Same three components and weights as three_normal_pdf_cdf above. Skewness and Kurtosis are deliberately NOT asserted: the port's Mixture::compute_moments integrates with adaptive Gauss-Kronrod where C# ComputeMoments calls the 1000-step CentralMoments(int) overload, so the two land ~2.5e-7 / ~8.7e-6 apart. NO oracle_skip and NO loosened tolerance -- see docs/upstream-csharp-issues.md.",
      "construct": {
        "components": [
          {"target": "Normal", "params": [10, 2]},
          {"target": "Normal", "params": [20, 1]},
          {"target": "Normal", "params": [30, 5]}
        ],
        "weights": [0.3, 0.2, 0.5]
      },
      "assertions": [
        { "method": "median",         "args": [], "expected": 21.27465332194634, "mode": "abs", "tol": 1e-8,  "source": "curated via oracle_emitter --dump" },
        { "method": "mode",           "args": [], "expected": 29.99999990517664, "mode": "abs", "tol": 1e-6,  "source": "curated via oracle_emitter --dump" },
        { "method": "log_pdf",        "args": [20], "expected": -2.4628973326762438, "mode": "abs", "tol": 1e-10, "source": "curated via oracle_emitter --dump" },
        { "method": "log_likelihood", "args": [8, 12, 19, 21, 28, 33], "expected": -19.168253138297175, "mode": "rel", "tol": 1e-10, "source": "curated via oracle_emitter --dump" },
        { "method": "random_value",   "args": [5, 42, 0], "expected": 20.82933648395096, "mode": "abs", "tol": 1e-12, "source": "curated via oracle_emitter --dump" },
        { "method": "random_value",   "args": [5, 42, 1], "expected": 25.48823684287538, "mode": "abs", "tol": 1e-12, "source": "curated via oracle_emitter --dump" },
        { "method": "random_value",   "args": [5, 42, 4], "expected": 9.72760591980181, "mode": "abs", "tol": 1e-12, "source": "curated via oracle_emitter --dump" }
      ]
    }
  ]
}
