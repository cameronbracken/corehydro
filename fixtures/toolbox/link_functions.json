    {"method": "link", "index": 2, "expected": 1.5, "mode": "equal", "source": "Test_IdentityLink_Link"},
    {"method": "d_link", "index": 1, "expected": 1.0, "mode": "equal", "source": "Test_IdentityLink_DLink"}
   ]
  },
  {
