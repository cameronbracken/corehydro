    {"method": "d_link", "index": 0, "expected": 1.0, "mode": "abs", "tol": 1e-12, "source": "Test_LogLink_DLink"},
    {"method": "d_link", "index": 1, "expected": 0.5, "mode": "abs", "tol": 1e-12, "source": "Test_LogLink_DLink"},
