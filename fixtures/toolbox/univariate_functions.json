{
 "kind": "toolbox",
 "group": "functions",
 "source": "Numerics/Functions at v2.2.0 and Test_Numerics/Functions tests for linear, power, tabular, segmented power, composite, and ensemble functions.",
 "reference": "Numerics @ 7e8e8d1. Legacy linear, power, and tabular cases retain their original C# literals. The v2.2.0 segmented, composite, and ensemble cases use shipped test literals or deterministic evaluations of the exact shipped test parameter sets. Every assertion is replayed through the real library by oracle_emitter.",
 "cases": [
  {
   "name": "linear_default_deterministic",
   "data": [[6]],
   "options": {"function": "linear", "parameters": [0, 1, 0]},
   "assertions": [
    {"method": "evaluate", "index": 0, "expected": 6, "mode": "equal", "source": "Test_Linear_Function (default ctor: alpha=0, beta=1)"}
   ]
  },
  {
   "name": "linear_evaluate",
   "data": [[6]],
   "options": {"function": "linear", "parameters": [-2, 5, 3]},
   "assertions": [
    {"method": "evaluate", "index": 0, "expected": 28, "mode": "equal", "source": "Test_Linear_Function (valid1 = 5*6 + -2, func1/func2 with no ConfidenceLevel set)"}
   ]
  },
  {
   "name": "linear_confidence_evaluate",
   "data": [[6]],
   "options": {"function": "linear", "parameters": [-2, 5, 3], "confidence_level": 0.75},
   "assertions": [
    {"method": "evaluate", "index": 0, "expected": 30.0234692505882, "mode": "abs", "tol": 1e-6, "source": "Test_Linear_Function (func2.ConfidenceLevel = 0.75; found using R's norminv())"}
   ]
  },
  {
   "name": "linear_round_trip_evaluate",
   "data": [[400]],
   "options": {"function": "linear", "parameters": [10, 0.5, 20]},
   "assertions": [
    {"method": "evaluate", "index": 0, "expected": 210, "mode": "abs", "tol": 1e-9, "source": "Test_Linear_Function_Inverse (computed: alpha + beta*x = 10 + 0.5*400, the deterministic Function() value the test's own y is not itself asserted against)"}
   ]
  },
  {
   "name": "linear_round_trip_inverse",
   "data": [[210]],
   "options": {"function": "linear", "parameters": [10, 0.5, 20]},
   "assertions": [
    {"method": "inverse", "index": 0, "expected": 400, "mode": "abs", "tol": 1e-6, "source": "Test_Linear_Function_Inverse (InverseFunction(Function(400)) == 400)"}
   ]
  },
  {
   "name": "linear_confidence_inverse",
   "data": [[6]],
   "options": {"function": "linear", "parameters": [-2, 5, 3], "confidence_level": 0.75},
   "assertions": [
    {"method": "inverse", "index": 0, "expected": 1.195306149882351, "mode": "abs", "tol": 1e-9, "source": "curated via oracle_emitter --dump (Test_Functions.cs never asserts InverseFunction() under a set ConfidenceLevel as a literal, only the round-trip identity at a different alpha/beta/sigma)"}
   ]
  },
