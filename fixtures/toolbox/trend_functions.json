    {"method": "predict", "index": 0, "expected": 50.0, "mode": "equal", "source": "ConstantTrendTests.Test_Predict_ReturnsConstantValue"},
    {"method": "predict", "index": 1, "expected": 50.0, "mode": "equal", "source": "ConstantTrendTests.Test_Predict_ReturnsConstantValue"},
    {"method": "predict", "index": 2, "expected": 50.0, "mode": "equal", "source": "ConstantTrendTests.Test_Predict_ReturnsConstantValue"}
   ]
  },
  {
